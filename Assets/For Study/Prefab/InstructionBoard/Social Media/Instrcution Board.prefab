  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Social media is part of our daily lives, profoundly shaping how we communicate
    and interact with one another. Supporters argue that platforms like Facebook,
    Tiktok, and Instagram have brought people closer together, fostering global connections,
    facilitating instant communication, and enabling the sharing of diverse ideas
    and cultures. Critics, however, argue that social media has led to increased
    feelings of isolation, superficial relationships, and echo chambers where individuals
    are exposed primarily to viewpoints similar to their own.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
