# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# Generated by Unity
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Memory captures can be large and contain sensitive data
/[Mm]emoryCaptures/

# Recordings can be large
/[Rr]ecordings/

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE folders
.vs/
.vscode/
.idea/

# Gradle cache directory
.gradle/

# Autogenerated solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Local API key, see RealtimeAPIWrapper
openai_api_key.txt
openai_api_key.txt.meta

# Motion recorded in the Editor, see VRMotionRecorder
/[Aa]ssets/VRRecordings/
/[Aa]ssets/VRRecordings.meta

# Local release helpers
/release_*.txt
/release_*.log
/capture.txt
/probe.txt
/shot.txt
/[Aa]ssets/Editor/_*.cs
/[Aa]ssets/Editor/_*.cs.meta
/[Aa]ssets/Editor.meta

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini
