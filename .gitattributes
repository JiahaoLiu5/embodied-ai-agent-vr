# Text files use LF in the repository and in the working copy
* text=auto eol=lf

# Source code
*.cs            text eol=lf diff=csharp
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.rsp           text eol=lf
*.shader        text eol=lf
*.cginc         text eol=lf
*.hlsl          text eol=lf
*.compute       text eol=lf
*.shadergraph   text eol=lf
*.gradle        text eol=lf
*.xml           text eol=lf

# Data and documents
*.json          text eol=lf
*.inputactions  text eol=lf
*.csv           text eol=lf
*.txt           text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.cff           text eol=lf

# Unity YAML
*.unity         text eol=lf
*.prefab        text eol=lf
*.meta          text eol=lf
*.mat           text eol=lf
*.anim          text eol=lf
*.controller    text eol=lf
*.overrideController text eol=lf
*.mask          text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial text eol=lf
*.renderTexture text eol=lf
*.playable      text eol=lf
*.preset        text eol=lf
*.lighting      text eol=lf
*.spriteatlas   text eol=lf
# Some .asset files are binary, so let git decide
*.asset         text=auto eol=lf

# Models
*.fbx           binary
*.FBX           binary
*.glb           binary
*.gltf          text eol=lf
*.obj           binary
*.blend         binary

# Images
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.psd           binary
*.tga           binary
*.tif           binary
*.exr           binary
*.hdr           binary
*.ico           binary

# Audio and video
*.mp3           binary
*.wav           binary
*.ogg           binary
*.mp4           binary
*.mov           binary

# Fonts, plugins, archives
*.ttf           binary
*.otf           binary
*.dll           binary
*.so            binary
*.a             binary
*.aar           binary
*.jar           binary
*.bundle        binary
*.dylib         binary
*.zip           binary
*.tgz           binary
*.pdf           binary

# Language statistics on GitHub
Assets/ThirdParty/** linguist-vendored
